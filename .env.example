# ─────────────────────────────────────────────────────────────────
#  .env  —  Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────────

# Postgres password
POSTGRES_PASSWORD=changeme_postgres

# Redis password
REDIS_PASSWORD=changeme_redis

# JWT signing secret (use a long random string in production)
JWT_SECRET=changeme_jwt_super_secret_key_32chars_min


# ── CONNECTION URLS (set these so frontend & backend know each other) ──

# Backend URL — where the frontend sends API requests.
# Docker same-host: leave empty (Nginx proxies /api/* internally).
# Cross-host / cloud:  set to your backend public URL.
#   e.g.  BACKEND_URL=https://api.example.com
BACKEND_URL=

# Frontend URL — the backend uses this for CORS (which origin to allow).
# Leave as * to allow all (fine for dev).
# Production: set to your exact frontend URL.
#   e.g.  FRONTEND_URL=https://app.example.com
FRONTEND_URL=*


# ── OPTIONAL (have sensible defaults) ───────────────────────────

# Backend port (default: 8080)
# PORT=8080

# Environment: development | production
# ENV=production
